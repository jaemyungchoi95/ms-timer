{
  "name": "ms-timer",
  "version": "1.2.0",
  "description": "목표 시각까지 1ms 단위 카운트다운 플립 시계",
  "author": "jmchoi",
  "license": "MIT",
  "main": "src/main.js",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "start": "electron .",
    "build": "electron-builder --win portable",
    "gen:sprites": "node tools/generate-cat-sheet.mjs",
    "assemble:sprites": "npm run gen:sprites && uv run --with pillow python tools/assemble_cat_sheet.py"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.jmchoi.ms-timer",
    "productName": "ms-timer",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "ms-timer.exe"
    }
  }
}
